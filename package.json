{
  "name": "bobblehead",
  "version": "0.1.0",
  "description": "A character for the top of your page that watches the cursor and reacts when you poke it.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "files": ["dist"],
  "keywords": ["react", "mascot", "cursor", "character", "sprite", "animation"],
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/GouravAkaJojo/bobblehead.git" },
  "homepage": "https://github.com/GouravAkaJojo/bobblehead#readme",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json",
    "demo": "vite build",
    "check": "tsc --noEmit"
  },
  "peerDependencies": { "react": ">=18" },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
